# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the example)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local store file for self-hosting without Upstash
/.data/

# Local AI assistant settings, never in the repo. AGENTS.md is the shared guide.
/CLAUDE.md
/.claude/

# Saved context.dev responses with other sites' text. Local only, never in the public repo.
/tests/fixtures/local/

# Created by `vercel link` and `vercel env pull`. Never committed.
.env*.local
