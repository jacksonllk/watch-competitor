# Copy this file to .env and fill in the values. Never commit .env.

# Required. Your context.dev API key.
# A restricted key needs Data APIs (use) and Monitors (manage).
CONTEXT_DEV_API_KEY=

# Database. Leave empty to save data to .data/store.json.
# Hosts that keep no files between requests need Upstash Redis.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 
# Set your public address, such as https://watch.example.com. 
# so new changes and Slack alerts arrive as soon as each check finishes.
APP_URL=

# Slack alerts. A Slack Incoming Webhook URL. Leave empty for no alerts.
SLACK_WEBHOOK_URL=
