# Copy this file to .env and fill in the values. Never commit .env.

# Required. Your context.dev API key. A restricted key needs Data APIs (use) and Monitors (manage).
CONTEXT_DEV_API_KEY=

# The most context.dev credits company previews may spend per day. Empty: 15.
PREVIEW_DAILY_CREDIT_CAP=

# Optional. The address of your copy, used for links in Slack alerts. Example: https://your-app.vercel.app
APP_URL=

# Optional. Slack Incoming Webhook URL. Without it, alerts are off.
SLACK_WEBHOOK_URL=
# Optional. A long random string. The alerts route runs only when called with it.
CRON_SECRET=

# Needed on Vercel. Upstash Redis keeps your competitors and every change they make.
# Running locally without it, the app saves to .data/store.json instead.
# Adding Upstash through the Vercel Marketplace sets KV_REST_API_URL and KV_REST_API_TOKEN instead. Both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
