# Copy this file to .env and fill in the values. Never commit .env.

# Required. Your context.dev API key. A restricted key needs Data APIs (use) and Monitors (manage).
CONTEXT_DEV_API_KEY=

# The most context.dev credits company previews may spend per day. Empty: 15.
PREVIEW_DAILY_CREDIT_CAP=

# Optional. The address of your copy, used for links in Slack alerts and for real-time updates. Example: https://watch.example.com
APP_URL=

# Optional. A Slack Incoming Webhook URL. With it, new changes are posted to that channel, one message per batch.
# Which changes alert is set in competitor-watch.config.json ("alerts"). Without it, alerts are off.
SLACK_WEBHOOK_URL=
# Optional. A long random string. Lets a scheduler call GET /api/cron with "Authorization: Bearer <CRON_SECRET>"
# to save new changes, check news and send alerts when nobody has the app open. Without it, /api/cron is off.
CRON_SECRET=

# Needed on hosts that keep no files between requests (serverless). Upstash Redis keeps your competitors and every change they make.
# Running locally without it, the app saves to .data/store.json instead.
# Some hosts' Upstash integrations set KV_REST_API_URL and KV_REST_API_TOKEN instead. Both work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional. Where "Contact support" in the app links: a web page (https://…) or an email address.
# The app says "Contact support" when your context.dev account stops a check, such as when it is out of credits.
# Without it, the words show with no link. The cause is always in the server log.
SUPPORT_URL=
